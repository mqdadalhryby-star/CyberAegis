<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ultimate OSINT & Cyber Intelligence Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { ink: '#0f172a', panel: '#111827', line: '#263244', neon: '#22d3ee', good: '#34d399', warn: '#fbbf24', bad: '#fb7185' } } } };
  </script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">
  <header class="sticky top-0 z-20 border-b border-line bg-slate-950/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-neon">CyberAegis local dashboard</p>
        <h1 class="text-2xl font-bold md:text-3xl">Ultimate OSINT & Cyber Intelligence Hub</h1>
        <p class="text-sm text-slate-400">Independent cards, isolated consoles, graceful timeouts, defensive workflow.</p>
      </div>
      <div class="rounded-2xl border border-line bg-panel p-3 text-sm">
        <label class="flex items-center gap-2 font-medium"><input id="authorized" type="checkbox" class="h-4 w-4 accent-cyan-400"> I have written authorization and will test only in-scope assets.</label>
        <div class="mt-2 grid grid-cols-2 gap-2 text-xs text-slate-400">
          <span>Mock mode: <b class="{{ 'text-warn' if mock_mode else 'text-good' }}">{{ 'ON' if mock_mode else 'OFF' }}</b></span>
          <span>Auth required: <b class="{{ 'text-warn' if require_authorization else 'text-good' }}">{{ 'YES' if require_authorization else 'NO' }}</b></span>
        </div>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-8 px-4 py-8">
    <section class="grid grid-cols-1 gap-5 xl:grid-cols-2">
      <div class="rounded-3xl border border-line bg-panel p-5 shadow-2xl" id="card-ai">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div><h2 class="text-xl font-bold">AI Security Assistant</h2><p class="text-sm text-slate-400">Defensive guidance, target triage, and next-step recommendations.</p></div>
          <span class="rounded-full bg-cyan-400/10 px-3 py-1 text-xs text-neon ring-1 ring-cyan-400/30">LLM / rules</span>
        </div>
        <textarea id="ai-message" rows="5" class="w-full rounded-2xl border border-line bg-slate-900 p-3 outline-none ring-cyan-400/40 focus:ring" placeholder="Ask: How should I triage a phishing email, exposed cloud bucket, suspicious subdomain, or WAF block?"></textarea>
        <div class="mt-3 flex gap-2">
          <button onclick="askAI()" class="rounded-2xl bg-cyan-400 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Ask Assistant</button>
          <button onclick="copyOut('ai-out')" class="rounded-2xl border border-line px-4 py-2 hover:bg-slate-800">Copy</button>
        </div>
        <pre id="ai-out" class="mt-4 min-h-48 overflow-auto rounded-2xl border border-line bg-black/40 p-3 text-xs text-slate-200"></pre>
      </div>

      <div class="rounded-3xl border border-line bg-panel p-5 shadow-2xl" id="card-threat">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div><h2 class="text-xl font-bold">Threat Intelligence Center</h2><p class="text-sm text-slate-400">IP/domain/URL/email/hash checks, DNS, and optional VT/AbuseIPDB enrichment.</p></div>
          <span class="rounded-full bg-rose-400/10 px-3 py-1 text-xs text-rose-300 ring-1 ring-rose-400/30">TI lookup</span>
        </div>
        <input id="threat-indicator" class="w-full rounded-2xl border border-line bg-slate-900 p-3 outline-none ring-cyan-400/40 focus:ring" placeholder="8.8.8.8, example.com, https://example.com, name@example.com, sha256">
        <div class="mt-3 flex gap-2">
          <button onclick="runThreat()" class="rounded-2xl bg-rose-400 px-4 py-2 font-semibold text-slate-950 hover:bg-rose-300">Check Indicator</button>
          <button onclick="copyOut('threat-out')" class="rounded-2xl border border-line px-4 py-2 hover:bg-slate-800">Copy</button>
        </div>
        <pre id="threat-out" class="mt-4 min-h-48 overflow-auto rounded-2xl border border-line bg-black/40 p-3 text-xs text-slate-200"></pre>
      </div>
    </section>

    <section class="grid grid-cols-1 gap-5 xl:grid-cols-2">
      <div class="rounded-3xl border border-line bg-panel p-5 shadow-2xl" id="card-analytics">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div><h2 class="text-xl font-bold">Advanced Analytics</h2><p class="text-sm text-slate-400">Paste findings JSON to compute risk bands, statistics, and correlation graph data.</p></div>
          <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300 ring-1 ring-emerald-400/30">Correlation</span>
        </div>
        <textarea id="analytics-input" rows="8" class="w-full rounded-2xl border border-line bg-slate-900 p-3 font-mono text-xs outline-none ring-cyan-400/40 focus:ring">[
  {"type":"email","value":"security@example.com","source":"holehe","severity":"low","target":"example.com"},
  {"type":"subdomain","value":"vpn.example.com","source":"sublist3r","severity":"medium","target":"example.com"},
  {"type":"ip","value":"203.0.113.10","source":"theharvester","severity":"high","target":"example.com"}
]</textarea>
        <div class="mt-3 flex gap-2">
          <button onclick="runAnalytics()" class="rounded-2xl bg-emerald-400 px-4 py-2 font-semibold text-slate-950 hover:bg-emerald-300">Process Analytics</button>
          <button onclick="copyOut('analytics-out')" class="rounded-2xl border border-line px-4 py-2 hover:bg-slate-800">Copy</button>
        </div>
        <pre id="analytics-out" class="mt-4 min-h-56 overflow-auto rounded-2xl border border-line bg-black/40 p-3 text-xs text-slate-200"></pre>
      </div>

      <div class="rounded-3xl border border-line bg-panel p-5 shadow-2xl" id="card-report">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div><h2 class="text-xl font-bold">Report Generator</h2><p class="text-sm text-slate-400">Compile threat intel and analytics into TXT, JSON, or HTML.</p></div>
          <span class="rounded-full bg-amber-400/10 px-3 py-1 text-xs text-amber-200 ring-1 ring-amber-400/30">Export</span>
        </div>
        <div class="grid gap-3 md:grid-cols-3">
          <input id="report-title" value="Authorized OSINT Assessment" class="rounded-2xl border border-line bg-slate-900 p-3 outline-none ring-cyan-400/40 focus:ring md:col-span-2">
          <select id="report-format" class="rounded-2xl border border-line bg-slate-900 p-3"><option value="html">HTML</option><option value="json">JSON</option><option value="txt">TXT</option></select>
        </div>
        <div class="mt-3 flex gap-2">
          <button onclick="generateReport(false)" class="rounded-2xl bg-amber-300 px-4 py-2 font-semibold text-slate-950 hover:bg-amber-200">Generate Report</button>
          <button onclick="generateReport(true)" class="rounded-2xl border border-line px-4 py-2 hover:bg-slate-800">Generate + Download</button>
        </div>
        <pre id="report-out" class="mt-4 min-h-56 overflow-auto rounded-2xl border border-line bg-black/40 p-3 text-xs text-slate-200"></pre>
      </div>
    </section>

    {% set people_tools = ['sherlock', 'maigret', 'whatsmyname'] %}
    <section class="rounded-3xl border border-line bg-panel p-5 shadow-2xl">
      <h2 class="text-xl font-bold">Username & People Search</h2><p class="mb-5 text-sm text-slate-400">Each username checker is isolated in its own card.</p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {% for key in people_tools %}{% set t = tools[key] %}
        <div class="rounded-2xl border border-line bg-slate-900/70 p-4" id="card-{{ key }}">
          <div class="mb-3 flex items-center justify-between"><h3 class="font-bold">{{ t.name }}</h3><span class="text-xs text-slate-500">{{ t.group }}</span></div>
          <label class="text-xs text-slate-400">{{ t.label }}</label>
          <input id="{{ key }}-value" placeholder="{{ t.placeholder }}" class="mt-1 w-full rounded-xl border border-line bg-slate-950 p-3 outline-none ring-cyan-400/30 focus:ring">
          <button onclick="runTool('{{ key }}')" class="mt-3 w-full rounded-xl bg-cyan-400 px-3 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Run {{ t.name }}</button>
          <pre id="{{ key }}-out" class="mt-3 min-h-40 overflow-auto rounded-xl border border-line bg-black/40 p-3 text-xs"></pre>
        </div>
        {% endfor %}
      </div>
    </section>

    {% set email_tools = ['holehe', 'mosint', 'ghunt'] %}
    <section class="rounded-3xl border border-line bg-panel p-5 shadow-2xl">
      <h2 class="text-xl font-bold">Email & Account Verification</h2><p class="mb-5 text-sm text-slate-400">Account-existence checks are separated per tool.</p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {% for key in email_tools %}{% set t = tools[key] %}
        <div class="rounded-2xl border border-line bg-slate-900/70 p-4" id="card-{{ key }}">
          <div class="mb-3 flex items-center justify-between"><h3 class="font-bold">{{ t.name }}</h3><span class="text-xs text-slate-500">{{ t.group }}</span></div>
          <label class="text-xs text-slate-400">{{ t.label }}</label>
          <input id="{{ key }}-value" placeholder="{{ t.placeholder }}" class="mt-1 w-full rounded-xl border border-line bg-slate-950 p-3 outline-none ring-cyan-400/30 focus:ring">
          <button onclick="runTool('{{ key }}')" class="mt-3 w-full rounded-xl bg-cyan-400 px-3 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Run {{ t.name }}</button>
          <pre id="{{ key }}-out" class="mt-3 min-h-40 overflow-auto rounded-xl border border-line bg-black/40 p-3 text-xs"></pre>
        </div>
        {% endfor %}
      </div>
    </section>

    {% set phone_tools = ['phoneinfoga'] %}
    <section class="rounded-3xl border border-line bg-panel p-5 shadow-2xl">
      <h2 class="text-xl font-bold">Phone Number Intelligence</h2><p class="mb-5 text-sm text-slate-400">Carrier/line-type enrichment in a dedicated container.</p>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-1">
        {% for key in phone_tools %}{% set t = tools[key] %}
        <div class="rounded-2xl border border-line bg-slate-900/70 p-4" id="card-{{ key }}">
          <div class="mb-3 flex items-center justify-between"><h3 class="font-bold">{{ t.name }}</h3><span class="text-xs text-slate-500">{{ t.group }}</span></div>
          <label class="text-xs text-slate-400">{{ t.label }}</label>
          <input id="{{ key }}-value" placeholder="{{ t.placeholder }}" class="mt-1 w-full rounded-xl border border-line bg-slate-950 p-3 outline-none ring-cyan-400/30 focus:ring">
          <button onclick="runTool('{{ key }}')" class="mt-3 rounded-xl bg-cyan-400 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Run {{ t.name }}</button>
          <pre id="{{ key }}-out" class="mt-3 min-h-40 overflow-auto rounded-xl border border-line bg-black/40 p-3 text-xs"></pre>
        </div>
        {% endfor %}
      </div>
    </section>

    {% set recon_tools = ['theharvester', 'sublist3r', 'amass', 'photon'] %}
    <section class="rounded-3xl border border-line bg-panel p-5 shadow-2xl">
      <h2 class="text-xl font-bold">Domain, Subdomain & URL Reconnaissance</h2><p class="mb-5 text-sm text-slate-400">Passive-first enumeration and crawling cards.</p>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {% for key in recon_tools %}{% set t = tools[key] %}
        <div class="rounded-2xl border border-line bg-slate-900/70 p-4" id="card-{{ key }}">
          <div class="mb-3 flex items-center justify-between"><h3 class="font-bold">{{ t.name }}</h3><span class="text-xs text-slate-500">{{ t.group }}</span></div>
          <label class="text-xs text-slate-400">{{ t.label }}</label>
          <input id="{{ key }}-value" placeholder="{{ t.placeholder }}" class="mt-1 w-full rounded-xl border border-line bg-slate-950 p-3 outline-none ring-cyan-400/30 focus:ring">
          <button onclick="runTool('{{ key }}')" class="mt-3 w-full rounded-xl bg-cyan-400 px-3 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Run {{ t.name }}</button>
          <pre id="{{ key }}-out" class="mt-3 min-h-44 overflow-auto rounded-xl border border-line bg-black/40 p-3 text-xs"></pre>
        </div>
        {% endfor %}
      </div>
    </section>

    {% set web_tools = ['whatweb', 'wafw00f'] %}
    <section class="rounded-3xl border border-line bg-panel p-5 shadow-2xl">
      <h2 class="text-xl font-bold">Web Technology & WAF Detection</h2><p class="mb-5 text-sm text-slate-400">Fingerprinting and WAF identification in separate cards.</p>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {% for key in web_tools %}{% set t = tools[key] %}
        <div class="rounded-2xl border border-line bg-slate-900/70 p-4" id="card-{{ key }}">
          <div class="mb-3 flex items-center justify-between"><h3 class="font-bold">{{ t.name }}</h3><span class="text-xs text-slate-500">{{ t.group }}</span></div>
          <label class="text-xs text-slate-400">{{ t.label }}</label>
          <input id="{{ key }}-value" placeholder="{{ t.placeholder }}" class="mt-1 w-full rounded-xl border border-line bg-slate-950 p-3 outline-none ring-cyan-400/30 focus:ring">
          <button onclick="runTool('{{ key }}')" class="mt-3 w-full rounded-xl bg-cyan-400 px-3 py-2 font-semibold text-slate-950 hover:bg-cyan-300">Run {{ t.name }}</button>
          <pre id="{{ key }}-out" class="mt-3 min-h-40 overflow-auto rounded-xl border border-line bg-black/40 p-3 text-xs"></pre>
        </div>
        {% endfor %}
      </div>
    </section>
  </main>

  <footer class="border-t border-line px-4 py-6 text-center text-xs text-slate-500">Defensive use only. No shell=True. Local execution. Outputs capped. Set MOCK_MODE=true for a safe demo.</footer>

  <script>
    let lastThreat = {};
    let lastAnalytics = {};

    function authHeaders() {
      return {
        'Content-Type': 'application/json',
        'X-OSINT-Authorized': document.getElementById('authorized').checked ? 'true' : 'false'
      };
    }

    function setOut(id, data, ok = true) {
      const el = document.getElementById(id);
      el.textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
      el.classList.toggle('text-emerald-300', !!ok);
      el.classList.toggle('text-rose-300', !ok);
    }

    function copyOut(id) {
      navigator.clipboard.writeText(document.getElementById(id).textContent || '').catch(() => {});
    }

    async function post(path, body) {
      const res = await fetch(path, { method: 'POST', headers: authHeaders(), body: JSON.stringify(body || {}) });
      let data = null;
      try { data = await res.json(); } catch (e) { data = { ok: false, error: 'Invalid JSON response', status: res.status }; }
      data.http_status = res.status;
      return data;
    }

    async function runTool(key) {
      const out = document.getElementById(key + '-out');
      const value = document.getElementById(key + '-value').value.trim();
      setOut(key + '-out', 'Running ' + key + ' ...');
      const data = await post('/api/tool/' + key, { value });
      setOut(key + '-out', data, data.ok && data.http_status < 400);
    }

    async function askAI() {
      setOut('ai-out', 'Thinking defensively ...');
      const data = await post('/api/ai', { message: document.getElementById('ai-message').value, context: { page: 'dashboard' } });
      setOut('ai-out', data, data.ok && data.http_status < 400);
    }

    async function runThreat() {
      setOut('threat-out', 'Checking indicator ...');
      const data = await post('/api/threat', { indicator: document.getElementById('threat-indicator').value.trim() });
      lastThreat = data;
      setOut('threat-out', data, data.ok && data.http_status < 400);
    }

    async function runAnalytics() {
      setOut('analytics-out', 'Processing findings ...');
      let findings;
      try { findings = JSON.parse(document.getElementById('analytics-input').value); }
      catch (e) { setOut('analytics-out', { ok: false, error: 'Invalid JSON: ' + e.message }, false); return; }
      const data = await post('/api/analytics', { findings });
      lastAnalytics = data;
      setOut('analytics-out', data, data.ok && data.http_status < 400);
    }

    async function generateReport(download) {
      setOut('report-out', 'Generating report ...');
      const data = await post('/api/report', {
        title: document.getElementById('report-title').value,
        format: document.getElementById('report-format').value,
        threat: lastThreat,
        analytics: lastAnalytics,
        findings: lastAnalytics.findings || []
      });
      setOut('report-out', { ok: data.ok, filename: data.filename, saved_to: data.saved_to, preview: (data.content || '').slice(0, 6000) }, data.ok && data.http_status < 400);
      if (download && data.ok) {
        const blob = new Blob([data.content], { type: data.mime });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = data.filename;
        a.click();
        URL.revokeObjectURL(a.href);
      }
    }
  </script>
</body>
</html>
